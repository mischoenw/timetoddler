CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# ESP32-S3R8: 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Logs go to UART0 (ZX-MX 1.25 connector); the USB port belongs to TinyUSB.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# USB: one vendor interface for WebUSB, no CDC
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=512
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=512

# LVGL 9: system malloc (PSRAM), TTF rendering for Latin-1 incl. umlauts
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_USE_LOG=n
